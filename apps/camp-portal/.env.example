# Supabase (public, safe to expose to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL of the donor-facing app (Person 3's project). Update this once it's
# deployed; defaults to the local dev port otherwise.
VITE_DONOR_PORTAL_URL=http://localhost:5173

# Optional UI gate only; this is embedded in the browser bundle and is not
# authentication. Keep the default 1234 only for local/demo use.
VITE_COORDINATOR_PIN=1234
