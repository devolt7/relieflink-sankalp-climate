# Supabase (public, safe to expose to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL of the deployed donor-facing app. For two-app local development,
# override this with http://localhost:5173 in your local .env.
VITE_DONOR_PORTAL_URL=https://relieflink-sankalp-climate.vercel.app

# Optional UI gate only; this is embedded in the browser bundle and is not
# authentication. Keep the default 1234 only for local/demo use.
VITE_COORDINATOR_PIN=1234
