{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "camp-portal": {
      "root": "apps/camp-portal",
      "framework": "vite"
    },
    "relieflink-donor-portal": {
      "root": "apps/relieflink-donor-portal",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/camp-portal/(.*)",
      "destination": {
        "service": "camp-portal"
      }
    },
    {
      "source": "/camp-portal",
      "destination": {
        "service": "camp-portal"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "relieflink-donor-portal"
      }
    }
  ]
}
